'
' Ported to Code is Fun's free mode (2026): the program is Rémi Poulin's, unchanged but for its files --
' a web page has none: its memory, MEMOIRE.DAT, is in DATA lines at the end of the module (label memoire),
' read with RESTORE / READ; info.ama (the name kept from one talk to the next) is not written: Amanda asks
' the name each time. Its WAIT &H3DA (the screen's retrace) and ON TIMER work as in QBasic.
' Three names are Onyx BASIC's French keywords there (REPETER, NON, FIN): the SUBs repeter and non are
' called redire and repnon, the variable fin is fini.
' Her face is new: a portrait in half blocks that blinks and talks (SUB portraitinit and the next ones).
' Keys: type a sentence, Enter; F1 help, F2 info, F3 speed, Esc quit.
DECLARE SUB graphic ()
DECLARE SUB bienvenue (a$, n$)
DECLARE SUB aurevoir (a$, n$)
DECLARE SUB redire (a$)
DECLARE SUB accent (lp, m$)
DECLARE SUB face0 (face, tim)
DECLARE SUB face1 (face, tim)
DECLARE SUB oui (que, a$)
DECLARE SUB repnon (que, a$)
DECLARE SUB quoi (a$, quo2)
DECLARE SUB ifthen (m$, a$)
DECLARE SUB aide (tim, face)
DECLARE SUB info (tim, face)
DECLARE SUB optionv (le, tim, face, a$, nom)
DECLARE SUB verbe (nom, a$, ge$, ge2$, ge3$, lenom$, ve$)
DECLARE SUB phrase (a$, ge$, ge2$, ge3$, nom, ha())
DECLARE SUB tempo (a$, te2)
DECLARE SUB finir (n$)
DECLARE SUB portraitinit ()
DECLARE SUB dessine (v, k1, k2, c1, c2)
DECLARE SUB cligne (ferme)
DECLARE SUB parle (c$)
DIM SHARED art$(17, 3), humeur, ouverte   ' (Port: the portrait -- humeur 0 normal, 1 annoyed, 9 hidden)

CLS : SCREEN 0: COLOR 7, 6
RANDOMIZE TIMER
FOR s = 1 TO 40: WAIT &H3DA, 8: WAIT &H3DA, 8, 8: NEXT s
n = 12: q = 1: le = 20: y = 0: fo = 1
DIM ha(21)
CALL graphic
CALL portraitinit
CALL face0(face, tim)

ON ERROR GOTO erreur
' (Port: no info.ama in a web page -- the name is asked each time)
a$ = "Bonjour, quel est votre nom?": nom = 1
GOTO reponse

erreur:
bb = 0
  'BEEP
REM  fichier non trouver
RESUME NEXT

REM --------- Amanda ---------

ga:
IF q = 0 THEN ON TIMER(n) GOSUB temp: TIMER ON: q = 1
IF a$ <> "" THEN GOTO reponse

IF lum = 2 THEN GOTO lum2
lum = 1
FOR i = fo TO 16: y = y + 2
  LOCATE 10, 21 + y: COLOR 4, 0: PRINT "█"
  LOCATE 10, 23 + y: COLOR 2, 0: PRINT "█"
  COLOR 14, 0
  clin = clin + 1: IF clin = 24 THEN CALL cligne(1)
  IF clin > 24 THEN CALL cligne(0): clin = INT(RND * 6)
  x$ = INKEY$: IF x$ <> "" THEN fo = i: y = y - 2: a$ = "": GOTO partir
  FOR s = 1 TO 70 / (le / 4): WAIT &H3DA, 8: WAIT &H3DA, 8, 8: NEXT s
NEXT i: fo = 1
lum2:
lum = 2
FOR i = fo TO 16: y = y - 2
  LOCATE 10, 25 + y: COLOR 4, 0: PRINT "█"
  LOCATE 10, 23 + y: COLOR 2, 0: PRINT "█"
  COLOR 14, 0
  clin = clin + 1: IF clin = 24 THEN CALL cligne(1)
  IF clin > 24 THEN CALL cligne(0): clin = INT(RND * 6)
  x$ = INKEY$: IF x$ <> "" THEN fo = i: y = y + 2: a$ = "": GOTO partir
  FOR s = 1 TO 70 / (le / 4): WAIT &H3DA, 8: WAIT &H3DA, 8, 8: NEXT s
NEXT i: y = 0: fo = 1: lum = 0
GOTO ga

partir:
TIMER OFF: q = 0
IF ASC(x$) = 27 THEN CALL aurevoir(a$, n$): fini = 1: GOTO reponse
IF ASC(x$) = 13 AND l = 6 THEN GOTO ga
IF ASC(x$) = 13 THEN GOTO choix
IF ASC(x$) = 8 AND l = 6 THEN GOTO ga
IF ASC(x$) = 8 THEN l = l - 1: LOCATE ra, l: COLOR 14, 1: PRINT "░"; : COLOR 14, 0: PRINT " "; : m$ = LEFT$(m$, LEN(m$) - 1): GOTO ga
IF ASC(x$) = 9 THEN GOTO ga
IF ASC(x$) = 12 OR ASC(x$) = 10 OR ASC(x$) = 11 OR ASC(x$) = 7 THEN GOTO ga
IF ASC(x$) = 28 OR ASC(x$) = 29 OR ASC(x$) = 30 OR ASC(x$) = 31 THEN GOTO ga
IF MID$(x$, 2, 1) = ";" THEN CALL aide(tim, face): GOTO ga
IF MID$(x$, 2, 1) = "<" THEN CALL info(tim, face): GOTO ga
IF MID$(x$, 2, 1) = "=" THEN CALL optionv(le, tim, face, a$, nom): que = 0: GOTO reponse
IF MID$(x$, 2, 1) <> "" THEN GOTO ga
IF l = 74 THEN GOTO ga
LOCATE ra, l: PRINT x$; : COLOR 14, 1: PRINT "░"; : l = l + 1: m$ = m$ + x$
GOTO ga

choix:
IF nom = 1 THEN n$ = m$: nom = 0: a$ = "Salut " + n$ + ", ca va bien?@005": GOTO reponse
lp = LEN(m$): lp% = lp
IF RIGHT$(m$, 1) = "?" THEN m$ = LEFT$(m$, lp - 1): lp = lp - 1
IF RIGHT$(m$, 1) = "!" THEN m$ = LEFT$(m$, lp - 1): lp = lp - 1
IF RIGHT$(m$, 1) = "." THEN m$ = LEFT$(m$, lp - 1): lp = lp - 1
mm$ = m$: CALL accent(lp, m$)
m$ = LCASE$(m$)
IF LEFT$(m$, 3) = "oui" OR LEFT$(m$, 5) = "ouais" THEN CALL oui(que, a$): GOTO reponse
IF LEFT$(m$, 3) = "non" THEN CALL repnon(que, a$): GOTO reponse
IF m$ = m2$ THEN CALL redire(a$): face = 1: que = 0: GOTO reponse
que = 0
IF LEFT$(m$, 8) = "aurevoir" OR LEFT$(m$, 3) = "bye" OR LEFT$(m$, 7) = "bonsoir" THEN CALL aurevoir(a$, n$): fini = 1
IF LEFT$(m$, 12) = "mon nom est " AND MID$(m$, 13, 1) <> "" THEN n$ = RIGHT$(mm$, lp - 12): a$ = "salut " + n$
IF LEFT$(m$, 13) = "je m'appelle " AND MID$(m$, 14, 1) <> "" THEN n$ = RIGHT$(mm$, lp - 13): a$ = "salut " + n$
IF m$ = "quel est mon nom" AND n$ = "" THEN a$ = "je ne sais pas ton nom"
IF m$ = "quel est mon nom" AND n$ <> "" THEN a$ = "ton nom est " + n$
IF LCASE$(mm$) = "qui est " + LCASE$(n$) AND n$ <> "" THEN a$ = "c'est ton nom!"
IF m$ = "aimes-tu " + n$ AND n$ <> "" THEN a$ = "oui, je t'aime beaucoup " + n$
CALL ifthen(m$, a$)
IF a$ = "" THEN GOTO scanneur

reponse:
COLOR 5, 0: FOR o = 3 TO 9: LOCATE o, 4
PRINT "                                                                        "
NEXT o

IF a$ = "" THEN a$ = "grrrr!"
IF MID$(a$, LEN(a$) - 3, 1) = "@" THEN que = VAL(RIGHT$(a$, 3)): a$ = LEFT$(a$, LEN(a$) - 4)
IF RIGHT$(a$, 1) = "#" THEN face = 1: a$ = LEFT$(a$, LEN(a$) - 1)
IF LEN(a$) > 200 THEN a$ = LEFT$(a$, 200)

LOCATE 4, 6: ra = 6
COLOR 4, 0: PRINT "<"; : COLOR 12, 0: PRINT "Amanda"; : COLOR 4, 0: PRINT ">  "; : COLOR 15, 0
FOR i = 1 TO LEN(a$): ma$ = LCASE$(MID$(a$, i, 1))
 IF ma$ = "a" OR ma$ = "e" OR ma$ = "i" OR ma$ = "o" OR ma$ = "u" OR ma$ = "y" THEN COLOR 7, 0 ELSE COLOR 15, 0
 IF ma$ = "é" OR ma$ = "ê" OR ma$ = "è" OR ma$ = "ë" OR ma$ = "à" OR ma$ = "É" THEN COLOR 7, 0
 PRINT MID$(a$, i, 1); : IF ma$ <> " " THEN SOUND 200, 1 / 10
 CALL parle(ma$)
 IF ma$ = "." AND MID$(a$, i + 1, 1) = " " THEN FOR s = 1 TO 35: WAIT &H3DA, 8: WAIT &H3DA, 8, 8: NEXT s
 IF ma$ = "," OR ma$ = "!" OR ma$ = "?" THEN FOR s = 1 TO 35: WAIT &H3DA, 8: WAIT &H3DA, 8, 8: NEXT s
 IF i = 60 THEN LOCATE 5, 6: ra = 7
 IF i = 130 THEN LOCATE 6, 6: ra = 8
 FOR s = 1 TO 70 / le: WAIT &H3DA, 8: WAIT &H3DA, 8, 8: NEXT s
NEXT i
SOUND 200, 0
CALL parle(" ")
IF i = 61 THEN ra = 6
IF i = 131 THEN ra = 7
FOR s = 1 TO 50: WAIT &H3DA, 8: WAIT &H3DA, 8, 8: NEXT s
IF fini = 1 THEN CALL finir(n$)
COLOR 14, 1: LOCATE ra, 6
PRINT "░";
IF face = 0 THEN CALL face0(face, tim)
IF face = 1 THEN CALL face1(face, tim)
m2$ = m$: l = 6: a$ = "": m$ = ""
GOTO ga

temp:
que = 0
CALL tempo(a$, te2)
tim = 1: q = 0: nom = 0
n = n + 5: IF n > 80 THEN n = 20
RETURN

ajuste:
a$ = d2$
IF plur = 1 THEN d1$ = d1t$
ca = VAL(MID$(STR$(car%), 2, 2))
IF ca = 71 THEN ve$ = d1$: ve = a% + lm% - 1: vrep$ = a$
IF ca < 70 AND nom = 0 AND a% > ve THEN nom = ca: nom2 = a%: genre = VAL(MID$(STR$(car%), 4, 1)): lenom$ = d1$
IF ca < 70 AND a% - 1 <= nom2 AND a% > ve THEN nom = ca: nom2 = a%: genre = VAL(MID$(STR$(car%), 4, 1)): lenom$ = d1$
plur = 0: d1$ = "aaaa"
RETURN

scanneur:
RESTORE memoire   ' (Port: the memory in DATA, at the end of the module)
m2$ = m$: lenom$ = ""
m$ = " " + m$ + " ": lp% = LEN(m$): plur = 0
ve$ = "": vrep$ = "": nom = 0: nom2 = 0: ve = 0
DO
  DO
    READ d1$: IF d1$ = "*FIN*" THEN GOTO sortie
  LOOP WHILE d1$ = "" OR LEFT$(d1$, 1) = "#"
    READ car%, d2$: lm% = LEN(d1$)
continue:
  FOR a% = 1 TO lp% - lm% + 1
    IF MID$(m$, a%, lm%) = d1$ THEN GOSUB ajuste
  NEXT a%
  plur = 0
  IF RIGHT$(d1$, 1) = " " AND car% <> 720 THEN d1t$ = d1$: plur = 1: d1$ = LEFT$(d1$, lm% - 1) + "s": GOTO continue
LOOP
sortie:
m$ = m2$
IF a$ = "" THEN CALL quoi(a$, quo2): GOTO reponse
IF ve$ = "" AND lenom$ = "" THEN GOTO reponse

IF genre = 1 THEN genre$ = " un ": genre2$ = " ce ": genre3$ = " le "
IF genre = 2 THEN genre$ = " une ": genre2$ = " cette ": genre3$ = " la "
IF MID$(lenom$, 1, 1) = " " OR MID$(lenom$, 1, 1) = "'" THEN lenom$ = MID$(lenom$, 2, LEN(lenom$))
IF MID$(lenom$, 1, 1) = "a" OR MID$(lenom$, 1, 1) = "e" OR MID$(lenom$, 1, 1) = "i" OR MID$(lenom$, 1, 1) = "o" OR MID$(lenom$, 1, 1) = "u" OR MID$(lenom$, 1, 1) = "h" THEN genre2$ = " cet ": genre3$ = " l'"
IF RIGHT$(lenom$, 1) = " " THEN lenom$ = MID$(lenom$, 1, LEN(lenom$) - 1)
ge$ = genre$ + lenom$
ge2$ = genre2$ + lenom$
ge3$ = genre3$ + lenom$

ha = INT(RND * 3) + 1
IF ve$ = "" AND ha <> 2 THEN CALL phrase(a$, ge$, ge2$, ge3$, nom, ha()): GOTO reponse
IF ve$ = "" AND ha = 2 THEN
  FOR i = 1 TO 8
    mo$(i) = mo$(i + 1)
  NEXT i
  mo$(9) = lenom$

  FOR i = 1 TO 8
    IF mo$(i) = lenom$ THEN CALL phrase(a$, ge$, ge2$, ge3$, nom, ha()): EXIT FOR
  NEXT i
END IF
IF ve$ = "" THEN GOTO reponse

IF nom = 0 THEN a$ = vrep$: GOTO reponse

CALL verbe(nom, a$, ge$, ge2$, ge3$, lenom$, ve$)
GOTO reponse


