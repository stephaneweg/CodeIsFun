SUB ifthen (m$, a$)
 
IF m$ = "ok" THEN a$ = "c'est correct"
IF LEFT$(m$, 5) = "merci" THEN a$ = "merci a vous aussi!"
IF m$ = "moi aussi" THEN a$ = "c'est bien"
IF m$ = "je ne sais pas" THEN a$ = "Hummm, c'est dommage que tu ne le sais pas!"
IF LEFT$(m$, 5) = "salut" THEN a$ = "salut"
IF LEFT$(m$, 4) = "allo" THEN a$ = "allo toi"
IF LEFT$(m$, 7) = "bonjour" THEN a$ = "bonjour mon cher ami"

IF m$ = "comment ca va" THEN a$ = "ca va très bien"
IF m$ = "comment vas-tu" OR m$ = "comment va tu" THEN a$ = "ca va très bien merci"
IF m$ = "desole" OR m$ = "excuse" OR m$ = "excuse moi" OR m$ = "je suis desole" OR m$ = "je m'excuse" THEN a$ = "ce n'est pas grave"
IF m$ = "quel est ton nom" OR m$ = "qui es-tu" OR RIGHT$(m$, 7) = "ton nom" THEN a$ = "mon nom est Amanda"
IF m$ = "quel age as-tu" OR m$ = "quel est ton age" OR RIGHT$(m$, 7) = "ton age" THEN a$ = "j'ai 22 ans"
